<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Exercício 40 - Formulário Acessível</title>
    <link rel="stylesheet" href="style.css">
</head>
<body>

    <main class="container">

        <form class="formulario" aria-labelledby="titulo-formulario">

            <h1 id="titulo-formulario">
                Cadastro de Usuário
            </h1>

            <div class="campo">
                <label for="nome">
                    Nome Completo
                </label>

                <input
                    type="text"
                    id="nome"
                    name="nome"
                    required
                    aria-required="true">
            </div>

            <div class="campo">
                <label for="email">
                    E-mail
                </label>

                <input
                    type="email"
                    id="email"
                    name="email"
                    required
                    aria-required="true">
            </div>

            <div class="campo">
                <label for="senha">
                    Senha
                </label>

                <input
                    type="password"
                    id="senha"
                    name="senha"
                    required
                    aria-required="true"
                    aria-describedby="ajuda-senha">
                
                <small id="ajuda-senha">
                    A senha deve possuir pelo menos 8 caracteres.
                </small>
            </div>

            <button type="submit">
                Cadastrar
            </button>

        </form>

    </main>

</body>
</html>