<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Exercício 07 - Validação HTML5</title>
    <link rel="stylesheet" href="style.css">
</head>
<body>

    <main>
        <form class="cadastro">

            <h1>Cadastro</h1>

            <label for="nome">Nome</label>
            <input
                type="text"
                id="nome"
                name="nome"
                required>

            <label for="email">E-mail</label>
            <input
                type="email"
                id="email"
                name="email"
                required
                placeholder="exemplo@email.com">

            <label for="senha">Senha</label>
            <input
                type="password"
                id="senha"
                name="senha"
                required
                pattern=".{8,}"
                title="A senha deve possuir pelo menos 8 caracteres">

            <button type="submit">Cadastrar</button>

        </form>
    </main>

</body>
</html>